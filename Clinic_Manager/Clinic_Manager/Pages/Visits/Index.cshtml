@page
@model Clinic_Manager.Pages.Visits.IndexModel
@{
    ViewData["Title"] = "Wizyty lekarskie";
    var currentStatus = Model.Status;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Harmonogram wizyt</h1>
    <a asp-page="Create" class="btn btn-success">+ Zaplanuj nową wizytę</a>
</div>

<!-- Filtrowanie po statusie -->
<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <a class="nav-link @(currentStatus == null ? "active" : "")" asp-page="Index" asp-route-Status="">Wszystkie</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentStatus == Clinic_Manager.Models.VisitStatus.Scheduled ? "active" : "")" asp-page="Index" asp-route-Status="Scheduled">Zaplanowane</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentStatus == Clinic_Manager.Models.VisitStatus.InProgress ? "active" : "")" asp-page="Index" asp-route-Status="InProgress">W trakcie</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentStatus == Clinic_Manager.Models.VisitStatus.Completed ? "active" : "")" asp-page="Index" asp-route-Status="Completed">Zakończone</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentStatus == Clinic_Manager.Models.VisitStatus.Canceled ? "active" : "")" asp-page="Index" asp-route-Status="Canceled">Anulowane</a>
    </li>
</ul>

@if (!Model.Visits.Any())
{
    <div class="alert alert-info">Brak wizyt pasujących do kryteriów.</div>
}
else
{
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Data i godzina</th>
                    <th>Pacjent</th>
                    <th>Lekarz prowadzący</th>
                    <th>Cel / Opis</th>
                    <th>Status</th>
                    <th class="text-end">Akcje</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var visit in Model.Visits)
                {
                    <tr>
                        <td><strong>@visit.VisitDate.ToString("yyyy-MM-dd HH:mm")</strong></td>
                        <td>@visit.PatientName</td>
                        <td>@visit.DoctorName</td>
                        <td>
                            <span class="text-truncate d-inline-block" style="max-width: 250px;" title="@visit.Description">
                                @(visit.Description ?? "—")
                            </span>
                        </td>
                        <td>
                            @switch (visit.Status)
                            {
                                case Clinic_Manager.Models.VisitStatus.Scheduled:
                                    <span class="badge bg-info text-dark">Zaplanowana</span>
                                    break;
                                case Clinic_Manager.Models.VisitStatus.InProgress:
                                    <span class="badge bg-warning text-dark">W trakcie</span>
                                    break;
                                case Clinic_Manager.Models.VisitStatus.Completed:
                                    <span class="badge bg-success">Zakończona</span>
                                    break;
                                case Clinic_Manager.Models.VisitStatus.Canceled:
                                    <span class="badge bg-danger">Anulowana</span>
                                    break;
                            }
                        </td>
                        <td class="text-end">
                            <a asp-page="Details" asp-route-id="@visit.Id" class="btn btn-sm btn-outline-info me-1">Szczegóły</a>
                            @if (visit.Status == Clinic_Manager.Models.VisitStatus.Scheduled)
                            {
                                <form method="post" asp-page-handler="UpdateStatus" asp-route-id="@visit.Id" asp-route-newStatus="InProgress" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-warning">Rozpocznij</button>
                                </form>
                                <form method="post" asp-page-handler="UpdateStatus" asp-route-id="@visit.Id" asp-route-newStatus="Canceled" class="d-inline"
                                      onsubmit="return confirm('Czy na pewno anulować tę wizytę?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Anuluj</button>
                                </form>
                            }
                            else if (visit.Status == Clinic_Manager.Models.VisitStatus.InProgress)
                            {
                                <form method="post" asp-page-handler="UpdateStatus" asp-route-id="@visit.Id" asp-route-newStatus="Completed" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-success">Zakończ</button>
                                </form>
                                <form method="post" asp-page-handler="UpdateStatus" asp-route-id="@visit.Id" asp-route-newStatus="Canceled" class="d-inline"
                                      onsubmit="return confirm('Czy na pewno anulować tę wizytę?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Anuluj</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
