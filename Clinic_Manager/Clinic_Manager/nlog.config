<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info"
      internalLogFile="internal-nlog-AspNetCore.txt">

  <!-- Włączenie rozszerzeń dla ASP.NET Core -->
  <extensions>
    <add assembly="NLog.Web.AspNetCore"/>
  </extensions>

  <!-- Definicja targetów (miejsc zapisu) -->
  <targets>
    <!-- Zapis do pliku logs/errors.log z odpowiednim layoutem -->
    <target xsi:type="File" name="errorFile" fileName="${aspnet-appbasepath}/logs/errors.log"
            layout="${longdate} | ${level:uppercase=true} | ${logger} | ${message}${onexception:inner= | ${exception:format=tostring}}" />

    <!-- Dodatkowy target dla konsoli systemowej (do debugowania lokalnego) -->
    <target xsi:type="Console" name="lifetimeConsole" layout="${MicrosoftConsoleLayout}" />
  </targets>

  <!-- Reguły mapowania loggerów na targety -->
  <rules>
    <!-- Wyłączenie zbytniego szumu z logów systemowych Microsoft na poziomie Info i niższym -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <!-- Wszystkie logi od poziomu Info trafiają do pliku oraz na konsolę -->
    <logger name="*" minlevel="Info" writeTo="errorFile,lifetimeConsole" />
  </rules>
</nlog>
